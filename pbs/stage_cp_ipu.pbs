#!/bin/bash -l
#PBS -N synth_cp_ipu
#PBS -l walltime=48:00:00
#PBS -l select=1:ncpus=1:mem=32GB
#PBS -j oe
#PBS -m abe
#PBS -r y

# CP-IPU: the CP-feasible candidate pool fitted with the shared IPU runner.
set -euo pipefail

SYNTH_POP="${SYNTH_POP:-/home/ahernz/Paper_Plan/synth_pop}"

# ---- paper hold-out basis (19 in-sample tables) --------------------------
# Without this the runner reads data_sa2_controls, which also holds the 7
# held-out tables, so the fit would optimise against them.
PAPER19="${PAPER19:-$SYNTH_POP/data_sa2_controls_v7}"
if [ ! -d "$PAPER19" ] || [ "$(ls -1 "$PAPER19"/*.csv 2>/dev/null | wc -l)" -lt 19 ]; then
  mkdir -p "$PAPER19"
  for t in indp sexp typp mtwp occp mstp incp stup rlhp hrsp heap qallp qalfp \
           rntrd mrerd vehrd nprd hind strd; do
    cp -f "$SYNTH_POP/data_sa2_controls/sa2${t}.csv" "$PAPER19/" 2>/dev/null || true
  done
fi
export SA_CONTROL_DIR="$PAPER19"
echo "  control basis: $SA_CONTROL_DIR ($(ls -1 "$SA_CONTROL_DIR"/*.csv 2>/dev/null | wc -l) tables)"
CPU_ENV_NAME="${CPU_ENV_NAME:-syn_env}"
CPU_ENV_PREFIX="${CPU_ENV_PREFIX:-/home/ahernz/miniconda3/envs}"
PYTHON_BIN="${CPU_ENV_PREFIX}/${CPU_ENV_NAME}/bin/python"
source /home/ahernz/miniconda3/etc/profile.d/conda.sh
conda activate "$CPU_ENV_NAME" || true
export USE_HPC=1

if [[ -n "${ZONES:-}" ]]; then
  read -r -a ZONE_VALUES <<< "$ZONES"
  ZONE_ARGS=(--zones "${ZONE_VALUES[@]}")
elif [[ -n "${CHUNK_ID:-}" ]]; then
  CHUNK_FILE="$SYNTH_POP/pbs/zone_chunks/chunk_${CHUNK_ID}.txt"
  [[ -s "$CHUNK_FILE" ]] || { echo "Missing chunk file: $CHUNK_FILE"; exit 1; }
  ZONE_ARGS=(--zones $(tr '\n' ' ' < "$CHUNK_FILE"))
else
  ZONE_ARGS=()
fi

cd "$SYNTH_POP"
# Versioned output directory so a corrected rerun does not overwrite the
# previous run (cp_pool_ipu.py reads config.CP_IPU_RESULTS_DIR).
export CP_IPU_RESULTS_DIR="${RESULTS_DIR:-$SYNTH_POP/outputs/cp_ipu_results}"
mkdir -p "$CP_IPU_RESULTS_DIR"
echo "  results dir: $CP_IPU_RESULTS_DIR"
"$PYTHON_BIN" -u cp_pool_ipu.py \
  --pool "${POOL_OVERRIDE:-}" \
  --max-iter "${SA_ITER:-1000}" \
  --control-scope "${SA_CONTROL_SCOPE:-statewide}" \
  "${ZONE_ARGS[@]}"
