#!/bin/bash -l
#PBS -N synth_cp_mip_chunk
#PBS -l walltime=12:00:00
#PBS -l select=1:ncpus=4:mem=48GB
#PBS -j n
#PBS -r y

# =============================================================================
# Stage CP-MIP chunk -- integer-count MIP fit (cp_pool_mip.py) over a zone
# subset of the CP feasible pool. Compute-node job: python runs HERE, never on
# the login/head node. The submitter (submit_cp_mip.sh) only calls qsub.
#
# One integer program per zone chooses replication counts over the zone's whole
# SA4 candidate slice (deduplicated into distinct household types, every
# candidate used -- no arbitrary cap), minimising unmet control cells then the
# 19-table deviation, with a pool-anchored joint/anchor block for out-of-sample
# generalisation. Writes zone_<zone>_synthetic_population.csv into
# CP_MIP_RESULTS_DIR so benchmark_margins.load_cp_mip_zones scores the full
# paper metric suite (RSSZ, TVD, SRMSE, MAE%).
#
# Env: SYNTH_POP, CHUNK_ID, ZONES, POOL_OVERRIDE, RESULTS_DIR, REP_MAX,
#      TIME_LIMIT, LAMBDA_JOINT, ANCHOR_ATTRS, JOINT_PAIRS, MAX_CANDIDATES
# =============================================================================

set -euo pipefail
SYNTH_POP="${SYNTH_POP:-/home/ahernz/Paper_Plan/synth_pop}"

# ---- 19-table paper control basis (exclude the 7 held-out tables) ----------
# Use the SAME directory every other paper arm used.  A local copy assembled
# from data_sa2_controls is not guaranteed to be identical (sa2hind/sa2stup
# differ between the v7 and paper19 builds), and a different control basis
# would make the CP-MIP RSSZ incomparable with the SA/IPU rows.
PAPER19="${PAPER19:-$SYNTH_POP/data_sa2_controls_paper19}"
if [ ! -d "$PAPER19" ] || [ "$(ls -1 "$PAPER19"/*.csv 2>/dev/null | wc -l)" -lt 19 ]; then
  echo "ERROR: 19-table control basis missing or incomplete: $PAPER19" >&2
  exit 1
fi
export SA_CONTROL_DIR="$PAPER19"
echo "  control basis: $SA_CONTROL_DIR ($(ls -1 "$SA_CONTROL_DIR"/*.csv 2>/dev/null | wc -l) tables)"

CHUNK_ID="${CHUNK_ID:-0}"; export CHUNK_ID
CPU_ENV_NAME="${CPU_ENV_NAME:-syn_env}"
CPU_ENV_PREFIX="${CPU_ENV_PREFIX:-/home/ahernz/miniconda3/envs}"
PYTHON_BIN="${CPU_ENV_PREFIX}/${CPU_ENV_NAME}/bin/python"
export USE_HPC=1
source /home/ahernz/miniconda3/etc/profile.d/conda.sh
conda activate "$CPU_ENV_NAME" || true
export PATH="$(dirname "$PYTHON_BIN"):$PATH"

POOL="${POOL_OVERRIDE:-$SYNTH_POP/outputs/feasible_pool.csv}"
RESULTS_DIR="${RESULTS_DIR:-$SYNTH_POP/outputs/cp_mip_results}"
mkdir -p "$RESULTS_DIR"
# Node-local cleaned-pool cache: avoids a shared-filesystem race between chunks.
export CP_POOL_CLEAN_CACHE="${TMPDIR:-/tmp}/pool_clean_${CHUNK_ID}.pkl"

REP_MAX="${REP_MAX:-6}"
TIME_LIMIT="${TIME_LIMIT:-120}"
LAMBDA_JOINT="${LAMBDA_JOINT:-1.0}"
ANCHOR_ATTRS="${ANCHOR_ATTRS:-bedrd hhcd tenlld}"
JOINT_PAIRS="${JOINT_PAIRS:-nprd:hhcd nprd:bedrd}"
MAX_CANDIDATES="${MAX_CANDIDATES:-}"

# Sweep-selected hyperparameters: when AUTO_SETTING=1, the scorer's
# best_setting.txt wins over the submitted defaults.  This lets the all-zone
# jobs be queued now with a dependency on the sweep scorer; they read the
# winning rep_max/lambda at execution time, not at qsub time.
AUTO_SETTING="${AUTO_SETTING:-0}"
SWEEP_BEST="${SWEEP_BEST:-}"
if [ "$AUTO_SETTING" = "1" ]; then
  if [ -f "$SWEEP_BEST" ]; then
    # shellcheck disable=SC1090
    source "$SWEEP_BEST"
    echo "  auto setting <- $SWEEP_BEST : rep_max=$REP_MAX lambda_joint=$LAMBDA_JOINT"
  else
    echo "  [warn] AUTO_SETTING=1 but $SWEEP_BEST missing; using submitted defaults"
  fi
fi

if [ -n "${ZONES_FILE:-}" ]; then
  [[ -f "$ZONES_FILE" ]] || { echo "ERROR: ZONES_FILE missing: $ZONES_FILE" >&2; exit 1; }
  ZONES="$(tr '\n' ' ' < "$ZONES_FILE")"
fi
[[ -n "${ZONES:-}" ]] || { echo "ERROR: ZONES empty for chunk ${CHUNK_ID}"; exit 1; }
echo "================================================================"
echo "  CP-MIP chunk ${CHUNK_ID}  ($(echo "$ZONES" | wc -w) zones)"
echo "  host=$(hostname)  job=${PBS_JOBID:-local}  start=$(date)"
echo "  pool=$POOL  rep_max=$REP_MAX  time_limit=$TIME_LIMIT  lambda_joint=$LAMBDA_JOINT"
echo "================================================================"

MAXC_ARG=()
[[ -n "$MAX_CANDIDATES" ]] && MAXC_ARG=(--max-candidates "$MAX_CANDIDATES")

cd "$SYNTH_POP"

# shellcheck disable=SC2086
"$PYTHON_BIN" -u "$SYNTH_POP/cp_pool_mip.py" \
    --pool "$POOL" --zones $ZONES \
    --rep-max "$REP_MAX" --time-limit "$TIME_LIMIT" \
    --lambda-joint "$LAMBDA_JOINT" \
    --anchor-attrs $ANCHOR_ATTRS --joint-pairs $JOINT_PAIRS \
    ${MAXC_ARG[@]+"${MAXC_ARG[@]}"} \
    --results-dir "$RESULTS_DIR"

MARK_DIR="$RESULTS_DIR/.done"; mkdir -p "$MARK_DIR"
{
  echo "chunk_id=${CHUNK_ID}"
  echo "zones=$(echo "$ZONES" | wc -w)"
  echo "finished=$(date -Is)"
  echo "summary=$RESULTS_DIR/cp_pool_rssz_summary_chunk${CHUNK_ID}.csv"
} > "$MARK_DIR/cp_mip_chunk${CHUNK_ID}.done"
echo "  CHUNK ${CHUNK_ID} COMPLETE : $(date)"
